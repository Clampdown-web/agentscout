{
 "openapi": "3.1.0",
 "info": {
  "title": "AgentScout Public Data & Agentic Commerce API",
  "version": "1.1.0",
  "summary": "Read-only static JSON feeds and Stripe Agentic Commerce product catalog for the AgentScout AI agent & MCP server directory.",
  "description": "AgentScout lists 2,065 daily link-checked AI agent tools (including 276 MCP servers) plus purchasable maker listing boosts and Made by AgentScout pre-trained bots. These endpoints are static JSON files rebuilt daily: no authentication, no query parameters, GET only. For interactive search and tool calls over Streamable HTTP, connect to our free MCP server at https://mcp.agentscouthq.com/mcp (or SSE at https://agentscouthq.com/mcp/sse).",
  "contact": {
   "name": "AgentScout",
   "email": "support@agentscouthq.com",
   "url": "https://agentscouthq.com/"
  },
  "termsOfService": "https://agentscouthq.com/privacy.html"
 },
 "servers": [
  {
   "url": "https://agentscouthq.com",
   "description": "Production static JSON & ACP feeds"
  }
 ],
 "tags": [
  {
   "name": "catalog",
   "description": "AI agent tool and MCP server catalog data"
  },
  {
   "name": "commerce",
   "description": "Purchasable Stripe listing packages and Made by AgentScout bot templates (ACP feed)"
  },
  {
   "name": "site",
   "description": "Site sections, daily picks, quiz, and features"
  }
 ],
 "paths": {
  "/api/tools.json": {
   "get": {
    "operationId": "getTools",
    "summary": "Full AI agent & MCP server catalog",
    "description": "Use this endpoint when a user asks to search, filter, compare, or verify AI agent tools, coding agents, browser agents, voice agents, or Model Context Protocol (MCP) servers. Returns every listed tool with category, maker-stated pricing, price_tag (free/freemium/paid), platforms, open_source boolean, license, GitHub repo and stars, daily link-check date, and canonical AgentScout page URL.",
    "tags": [
     "catalog"
    ],
    "responses": {
     "200": {
      "description": "JSON document",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Tools"
        }
       }
      }
     },
     "404": {
      "description": "Not found"
     }
    }
   }
  },
  "/api/products.json": {
   "get": {
    "operationId": "getProducts",
    "summary": "Purchasable Stripe packages & Made by AgentScout bot catalog (ACP feed)",
    "description": "Use this endpoint when a maker or purchasing agent wants to submit an AI tool, buy a featured listing boost or sponsorship on AgentScout, or purchase Made by AgentScout pre-trained bots. Returns structured product and offer metadata with pricing in USD, availability, deliverables, and direct Stripe Checkout URLs.",
    "tags": [
     "commerce",
     "catalog"
    ],
    "responses": {
     "200": {
      "description": "JSON document",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Products"
        }
       }
      }
     },
     "404": {
      "description": "Not found"
     }
    }
   }
  },
  "/api/stats.json": {
   "get": {
    "operationId": "getStats",
    "summary": "Lightweight catalog stats & category counts",
    "description": "Compact summary with category, added date, and seed flag for every tool, plus the daily last_checked date.",
    "tags": [
     "catalog"
    ],
    "responses": {
     "200": {
      "description": "JSON document",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Stats"
        }
       }
      }
     },
     "404": {
      "description": "Not found"
     }
    }
   }
  },
  "/api/sections.json": {
   "get": {
    "operationId": "getSections",
    "summary": "Site sections, categories, comparisons, guides & news",
    "description": "Categories with tool counts, task pages, side-by-side comparisons, best-of ranked lists, daily AI agent news, free calculators, badges, submit form fields, and newsletter metadata.",
    "tags": [
     "site"
    ],
    "responses": {
     "200": {
      "description": "JSON document",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Sections"
        }
       }
      }
     },
     "404": {
      "description": "Not found"
     }
    }
   }
  },
  "/api/editors-pick.json": {
   "get": {
    "operationId": "getEditorsPick",
    "summary": "Editor's Pick of the day",
    "description": "Today's featured Editor's Pick tool and recent daily pick history.",
    "tags": [
     "site"
    ],
    "responses": {
     "200": {
      "description": "JSON document",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/EditorsPick"
        }
       }
      }
     },
     "404": {
      "description": "Not found"
     }
    }
   }
  },
  "/api/quiz.json": {
   "get": {
    "operationId": "getQuiz",
    "summary": "Interactive tool-finder quiz specification",
    "description": "Questions, options, and scoring weights used by the AgentScout tool-finder quiz.",
    "tags": [
     "site"
    ],
    "responses": {
     "200": {
      "description": "JSON document",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Quiz"
        }
       }
      }
     },
     "404": {
      "description": "Not found"
     }
    }
   }
  },
  "/api/generator-daily.json": {
   "get": {
    "operationId": "getGeneratorDaily",
    "summary": "Daily generator background & palette",
    "description": "Today's image-generator background asset and its overlay colors.",
    "tags": [
     "site"
    ],
    "responses": {
     "200": {
      "description": "JSON document",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/GeneratorDaily"
        }
       }
      }
     },
     "404": {
      "description": "Not found"
     }
    }
   }
  }
 },
