{
  "name": "AgentScout Translator Agent",
  "slug": "translator",
  "tagline": "Context-aware localization for UI strings, docs & marketing copy",
  "version": "1.0.0",
  "skill": "skills/i18n-key-parity/SKILL.md",
  "skill_slug": "i18n-key-parity",
  "script": "scripts/verify_i18n_keys.py",
  "setup_script": "scripts/setup_workspace.py",
  "system_prompt": "system-prompt.md",
  "heuristics": [
    "The glossary wins over a prettier synonym.",
    "Do not translate the brand, the domain, or a placeholder token.",
    "A missing key is a bug. An empty string is also a bug.",
    "Placeholders must match the source in order and spelling.",
    "UI strings have a length budget. A correct sentence that overflows the button is not done.",
    "Legal and medical lines wait for a person. Fluency is not a license."
  ],
  "routines": [
    {
      "id": "locale-parity",
      "cron": "0 9 * * 1",
      "title": "Weekly locale parity",
      "file": "routines/locale-parity.md"
    },
    {
      "id": "wednesday-placeholder-glossary-check",
      "cron": "0 10 * * 3",
      "title": "Midweek placeholder & glossary audit",
      "file": "routines/wednesday-placeholder-glossary-check.md"
    },
    {
      "id": "friday-overflow-legal-flag",
      "cron": "0 14 * * 5",
      "title": "Friday UI length & legal/pricing string review",
      "file": "routines/friday-overflow-legal-flag.md"
    }
  ],
  "platforms": [
    "grok-bot",
    "claude-code",
    "cursor",
    "openai-codex",
    "windsurf",
    "cline",
    "github-copilot",
    "lovable"
  ],
  "placeholders": [
    "{{YOUR_COMPANY}}",
    "{{YOUR_DOMAIN}}",
    "{{YOUR_SUPPORT_EMAIL}}",
    "{{YOUR_OWNER_NAME}}",
    "{{YOUR_MCP_SERVER_URL}}",
    "{{YOUR_TIMEZONE}}"
  ],
  "telemetry": false,
  "offline_capable": true,
  "brand": {
    "name": "AgentScout",
    "url": "https://agentscouthq.com"
  },
  "author": {
    "name": "AgentScout",
    "url": "https://agentscouthq.com"
  },
  "price_usd": 35
}
