{
  "name": "AgentScout Data Analyst Agent",
  "slug": "data-analyst",
  "tagline": "Weekly KPI reports, cohort retention & revenue anomaly alerts",
  "version": "1.0.0",
  "skill": "skills/kpi-csv-analyst/SKILL.md",
  "skill_slug": "kpi-csv-analyst",
  "script": "scripts/analyze_kpi_csv.py",
  "setup_script": "scripts/setup_workspace.py",
  "system_prompt": "system-prompt.md",
  "heuristics": [
    "Define the metric before you compute it. Name the numerator and the denominator.",
    "Check nulls, duplicate months, and a single month that is an order of magnitude off.",
    "An anomaly is a z-score plus a sentence, not a chart decoration.",
    "LTV from ARPU divided by logo churn is directional. Say so.",
    "Three bullets of 'so what' beat a gallery of charts.",
    "If the export and the finance system disagree, stop and show both numbers."
  ],
  "routines": [
    {
      "id": "weekly-kpi",
      "cron": "0 8 * * 1",
      "title": "Weekly KPI narrative",
      "file": "routines/weekly-kpi.md"
    },
    {
      "id": "midweek-anomaly-scan",
      "cron": "0 9 * * 3",
      "title": "Midweek revenue & churn anomaly scan",
      "file": "routines/midweek-anomaly-scan.md"
    },
    {
      "id": "monthly-cohort-ltv-pack",
      "cron": "0 9 1 * *",
      "title": "Monthly LTV & retention summary",
      "file": "routines/monthly-cohort-ltv-pack.md"
    }
  ],
  "platforms": [
    "grok-bot",
    "claude-code",
    "cursor",
    "openai-codex",
    "windsurf",
    "cline",
    "github-copilot",
    "lovable"
  ],
  "placeholders": [
    "{{YOUR_COMPANY}}",
    "{{YOUR_DOMAIN}}",
    "{{YOUR_SUPPORT_EMAIL}}",
    "{{YOUR_OWNER_NAME}}",
    "{{YOUR_MCP_SERVER_URL}}",
    "{{YOUR_TIMEZONE}}"
  ],
  "telemetry": false,
  "offline_capable": true,
  "brand": {
    "name": "AgentScout",
    "url": "https://agentscouthq.com"
  },
  "author": {
    "name": "AgentScout",
    "url": "https://agentscouthq.com"
  },
  "price_usd": 35
}
