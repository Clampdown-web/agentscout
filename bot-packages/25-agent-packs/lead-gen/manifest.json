{
  "name": "AgentScout Lead Gen Agent",
  "slug": "lead-gen",
  "tagline": "Daily B2B prospect discovery, ICP scoring & verified lead lists",
  "version": "1.0.0",
  "skill": "skills/icp-lead-scoring/SKILL.md",
  "skill_slug": "icp-lead-scoring",
  "script": "scripts/score_leads_pipeline.py",
  "setup_script": "scripts/setup_workspace.py",
  "system_prompt": "system-prompt.md",
  "heuristics": [
    "Write the ICP and the anti-ICP before you score a single row.",
    "A buying signal beats a big employee count.",
    "Dedupe on the domain, not the display name.",
    "An email that fails a basic shape check does not enter the send queue.",
    "Log where the row came from. A lead without a source is a rumor.",
    "Cap the daily batch. A smaller list that sales will touch beats a dump."
  ],
  "routines": [
    {
      "id": "daily-lead-batch",
      "cron": "0 8 * * 1-5",
      "title": "Daily qualified lead batch",
      "file": "routines/daily-lead-batch.md"
    },
    {
      "id": "weekly-icp-refresh",
      "cron": "0 11 * * 5",
      "title": "Weekly ICP refresh",
      "file": "routines/weekly-icp-refresh.md"
    },
    {
      "id": "midweek-signal-sweep",
      "cron": "0 13 * * 3",
      "title": "Midweek buying-signal sweep",
      "file": "routines/midweek-signal-sweep.md"
    }
  ],
  "platforms": [
    "grok-bot",
    "claude-code",
    "cursor",
    "openai-codex",
    "windsurf",
    "cline",
    "github-copilot",
    "lovable"
  ],
  "placeholders": [
    "{{YOUR_COMPANY}}",
    "{{YOUR_DOMAIN}}",
    "{{YOUR_SUPPORT_EMAIL}}",
    "{{YOUR_OWNER_NAME}}",
    "{{YOUR_MCP_SERVER_URL}}",
    "{{YOUR_TIMEZONE}}"
  ],
  "telemetry": false,
  "offline_capable": true,
  "brand": {
    "name": "AgentScout",
    "url": "https://agentscouthq.com"
  },
  "author": {
    "name": "AgentScout",
    "url": "https://agentscouthq.com"
  },
  "price_usd": 35
}
