{
 "openapi": "3.1.0",
 "info": {
  "title": "AgentScout public data API",
  "version": "1.0.0",
  "summary": "Read-only static JSON feeds of the AgentScout AI agent tool directory.",
  "description": "AgentScout lists 1,786 AI agent tools. These endpoints are static JSON files rebuilt daily: no authentication, no query parameters, GET only. Filter client-side.",
  "contact": {
   "name": "AgentScout",
   "email": "support@agentscouthq.com",
   "url": "https://agentscouthq.com/"
  },
  "termsOfService": "https://agentscouthq.com/privacy.html"
 },
 "servers": [
  {
   "url": "https://agentscouthq.com"
  }
 ],
 "tags": [
  {
   "name": "catalog",
   "description": "Tool catalog data"
  },
  {
   "name": "site",
   "description": "Site sections and features"
  }
 ],
 "paths": {
  "/api/tools.json": {
   "get": {
    "operationId": "getTools",
    "summary": "Full tool catalog",
    "description": "Every listed AI agent tool with category, pricing, platforms, GitHub data, ratings and its AgentScout page. Rebuilt daily.",
    "tags": [
     "catalog"
    ],
    "responses": {
     "200": {
      "description": "JSON document",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Tools"
        }
       }
      }
     },
     "404": {
      "description": "Not found"
     }
    }
   }
  },
  "/api/stats.json": {
   "get": {
    "operationId": "getStats",
    "summary": "Lightweight catalog stats",
    "description": "Category, added date and seed flag for every tool, plus the last-checked date. Small file for homepage counters.",
    "tags": [
     "catalog"
    ],
    "responses": {
     "200": {
      "description": "JSON document",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Stats"
        }
       }
      }
     },
     "404": {
      "description": "Not found"
     }
    }
   }
  },
  "/api/sections.json": {
   "get": {
    "operationId": "getSections",
    "summary": "Site sections",
    "description": "Categories with counts, task pages, comparisons, best-of lists, news, free tools, badges, submit form fields and newsletter info.",
    "tags": [
     "site"
    ],
    "responses": {
     "200": {
      "description": "JSON document",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Sections"
        }
       }
      }
     },
     "404": {
      "description": "Not found"
     }
    }
   }
  },
  "/api/editors-pick.json": {
   "get": {
    "operationId": "getEditorsPick",
    "summary": "Editor's Pick of the day",
    "description": "Today's Editor's Pick and recent pick history.",
    "tags": [
     "site"
    ],
    "responses": {
     "200": {
      "description": "JSON document",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/EditorsPick"
        }
       }
      }
     },
     "404": {
      "description": "Not found"
     }
    }
   }
  },
  "/api/quiz.json": {
   "get": {
    "operationId": "getQuiz",
    "summary": "Tool-finder quiz",
    "description": "Questions, options and scoring weights used by the tool-finder quiz.",
    "tags": [
     "site"
    ],
    "responses": {
     "200": {
      "description": "JSON document",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Quiz"
        }
       }
      }
     },
     "404": {
      "description": "Not found"
     }
    }
   }
  },
  "/api/generator-daily.json": {
   "get": {
    "operationId": "getGeneratorDaily",
    "summary": "Daily generator image",
    "description": "Today's image-generator background and its overlay colours.",
    "tags": [
     "site"
    ],
    "responses": {
     "200": {
      "description": "JSON document",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/GeneratorDaily"
        }
       }
      }
     },
     "404": {
      "description": "Not found"
     }
    }
   }
  }
 },
